  # Database Configuration
  DATABASE_HOST=postgres
  DATABASE_PORT=5432
  DATABASE_USER=admin
  DATABASE_PASSWORD=admin123
  DATABASE_NAME=engine

  # Server Configuration
  # Routed through Caddy's self-signed local HTTPS (see caddy/conf/Caddyfile)
  VITE_API_BASE_URL=https://localhost:8444
  PORT=8080
  GIN_MODE=debug

  # CORS — the frontend is now served over https://localhost:8443 (Caddy)
  CORS_ALLOWED_ORIGIN=https://localhost:8443

  # JWT Configuration
  JWT_SECRET=secret
  JWT_EXPIRY=86400

  # Game Engine Configuration
  ENGINE_HOST=engine
  ENGINE_PORT=9090

  # Grafana Configuration
  GRAFANA_ADMIN_USER=admin
  GRAFANA_ADMIN_PASSWORD=admin123

  DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/placeholder-replace-me

  # OAuth — the frontend origin OAuth callbacks redirect back to after login
  FRONTEND_URL=https://localhost:8443

  # GitHub OAuth (create at https://github.com/settings/developers)
  GITHUB_CLIENT_ID=
  GITHUB_CLIENT_SECRET=
  GITHUB_REDIRECT_URL=https://localhost:8444/auth/github/callback

  # Google OAuth (create at https://console.cloud.google.com/apis/credentials)
  GOOGLE_CLIENT_ID=
  GOOGLE_CLIENT_SECRET=
  GOOGLE_REDIRECT_URL=https://localhost:8444/auth/google/callback
