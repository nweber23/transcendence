      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(caddy_http_request_duration_seconds_count{server=~\"frontend_.*\",code=~\"2..\"}[5m])) / sum(rate(caddy_http_request_duration_seconds_count{server=~\"frontend_.*\"}[5m]))",
          "legendFormat": "Frontend 2xx %"
        }
      ],
