      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(caddy_http_request_duration_seconds_bucket{server=~\"frontend_.*\"}[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(caddy_http_request_duration_seconds_bucket{server=~\"frontend_.*\"}[5m])) by (le))",
          "legendFormat": "p95"
        },
