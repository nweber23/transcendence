{
	# Bind admin API to all interfaces so Prometheus (another container) can reach it
	admin 0.0.0.0:2019

	# Enables the /metrics endpoint on the admin API (localhost:2019/metrics)
	metrics

	# Names the "server" label Caddy stamps on every caddy_http_* metric.
	# Without this Caddy auto-numbers listeners srv0, srv1, srv2... in
	# whatever order they're adapted from this file -- adding the :443/:8443
	# blocks below silently reshuffled that numbering and broke every
	# Grafana panel/alert that assumed srv0=frontend, srv1=backend. Naming
	# them here makes the label stable across Caddyfile edits.
	servers :80 {
		name frontend_http
	}
	servers :81 {
		name backend_http
	}
	servers :443 {
		name frontend_https
	}
	servers :8443 {
		name backend_https
	}
}

:80 {
	reverse_proxy frontend:5173

	log {
		output stdout
		format json
	}
}

:81 {
	reverse_proxy backend:8080

	log {
		output stdout
		format json
	}
}

localhost:443, 127.0.0.1:443 {
	tls internal

	reverse_proxy frontend:5173

	log {
		output stdout
		format json
	}
}

localhost:8443, 127.0.0.1:8443 {
	tls internal

	reverse_proxy backend:8080

	log {
		output stdout
		format json
	}
}
