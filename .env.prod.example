  # Copy to .env.prod and fill in real values, then run: make prod-up
  #
  # TLS/reverse proxy is handled by nginx on the VPS host, not by this repo's
  # Docker Caddy service (dev-only) — see docker-compose.prod.yml.
  #
  # Never commit the filled-in .env.prod file.

  # Database Configuration — use a strong, unique password in production
  DATABASE_HOST=postgres
  DATABASE_PORT=5432
  DATABASE_USER=admin
  DATABASE_PASSWORD=change-me-to-a-strong-password
  DATABASE_NAME=engine

  # Server Configuration
  # Frontend is built with this baked in as the API origin it talks to.
  VITE_API_BASE_URL=your-domain.com
  PORT=8080
  GIN_MODE=release

  # CORS — restrict the API to the real frontend origin instead of "*"
  CORS_ALLOWED_ORIGIN=api.your-domain.com

  # JWT Configuration — use a long random secret in production
  JWT_SECRET=change-me-to-a-long-random-secret
  JWT_EXPIRY=86400

  # Game Engine Configuration
  ENGINE_HOST=engine
  ENGINE_PORT=9090

  # Grafana Configuration
  GRAFANA_ADMIN_USER=admin
  GRAFANA_ADMIN_PASSWORD=change-me-to-a-strong-password
  DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1527279934609952798/RRC4KTYD4FCfuZS0wNKClhJIXO4ctyG6FYAP4mJQC2Vxd6ubfbYOTV-5gNYVSGgmyPEL
